// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	// Use Docker Compose for multi-container setup (app + Zipkin)

	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/cirrus",

	// Increase memory limits for running local LLM models 
	//
	// *** Removed temporarily, as we are not using local llms for now
	//
	// "hostRequirements": {
	// 	"memory": "8gb",
	// 	"cpus": 4
	// },
	
	// "runArgs": [
	// 	"--memory=8g",
	// 	"--memory-swap=12g",
	// 	"--shm-size=2g"
	// ],

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/github-cli": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/powershell": {
			"version": "7.5.4"
		}
	},

	// Forward ports for MSAL authentication redirect and Zipkin UI
	"forwardPorts": [50000, 50001, 50002, 50003, 50004, 50005, 50006, 50007, 50008, 50009, 9411],
	"portsAttributes": {
		"5*": {
			"onAutoForward": "openBrowserOnce"
		},
		"9411": {
			"label": "Zipkin UI",
			"onAutoForward": "notify"
		}
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "./.devcontainer/post-create.sh",
	
	// Use 'postStartCommand' to set up browser symlinks after VS Code environment is ready
	"postStartCommand": "./.devcontainer/post-start.sh",

	// Add az CLI to PATH for both Debug and Release builds
	// Set BROWSER to use VS Code's built-in browser opener for authentication flows
	// Set ZIPKIN_ENDPOINT to point to the Zipkin container
	"remoteEnv": {
		"PATH": "${containerWorkspaceFolder}/artifacts/Debug/Eval:${containerWorkspaceFolder}/artifacts/Debug/Core.Cli:${containerWorkspaceFolder}/artifacts/Release/Core.Cli:${containerEnv:PATH}",
		"BROWSER": "${containerEnv:BROWSER}",
		"ZIPKIN_ENDPOINT": "http://zipkin:9411/api/v2/spans"
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit"
			]
		}
	},

	// root is required here to install PowerShell modules in post-create.sh; pwsh itself does not require root
	"remoteUser": "vscode"
}
