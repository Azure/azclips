// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	// Use Docker Compose to define the dev container service

	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/azclips",

	// Increase memory limits for running local LLM models 
	//
	// *** Removed temporarily, as we are not using local llms for now
	//
	// "hostRequirements": {
	// 	"memory": "8gb",
	// 	"cpus": 4
	// },
	
	// "runArgs": [
	// 	"--memory=8g",
	// 	"--memory-swap=12g",
	// 	"--shm-size=2g"
	// ],

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/github-cli": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/powershell": {
			"version": "7.5.4"
		}
	},

	// Forward ports for MSAL authentication redirect
	"forwardPorts": [50000, 50001, 50002, 50003, 50004, 50005, 50006, 50007, 50008, 50009],
	"portsAttributes": {
		"5*": {
			"onAutoForward": "openBrowserOnce"
		}
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "./.devcontainer/post-create.sh",
	
	// Use 'postStartCommand' to install browser launchers after VS Code environment is ready
	"postStartCommand": "./.devcontainer/post-start.sh",

	// Add az CLI to PATH for both Debug and Release builds.
	// BROWSER is deliberately not set here: VS Code injects it into integrated
	// terminals on its own, and "${containerEnv:BROWSER}" would only shadow that
	// with an empty value.
	"remoteEnv": {
		"PATH": "${containerWorkspaceFolder}/artifacts/Debug/Core.Cli:${containerWorkspaceFolder}/artifacts/Release/Core.Cli:${containerEnv:PATH}"
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit"
			]
		}
	},

	// root is required here to install PowerShell modules in post-create.sh; pwsh itself does not require root
	"remoteUser": "vscode"
}
