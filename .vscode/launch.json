    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: group get Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core/Core.Cli.dll",
            "args": [
                "group",
                "get",
                "--name",
                "example-group"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core",
            "console": "integratedTerminal"
        },
        {
            "name": "C#: login Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core/Core.Cli.dll",
            "args": [
                "login"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core",
            "console": "integratedTerminal"
        },
    ]
}