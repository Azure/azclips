{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "az: group create (extension)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "group",
                "create",
                "--ResourceGroupName",
                "test-rg",
                "--Location",
                "eastus",
                "--SubscriptionId",
                "00000000-0000-0000-0000-000000000000",
                "--AccessToken",
                "placeholder-token"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal",
            "env": {
                "AZURE_CLI_EXTENSION_DIRECTORY": "${workspaceFolder}/artifacts/Debug/Core.Cli"
            }
        },
        {
            "name": "az: natural language (AI)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "create",
                "a",
                "resource",
                "group",
                "named",
                "test"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal",
            "env": {
                "AZURE_CLI_EXTENSION_DIRECTORY": "${workspaceFolder}/artifacts/Debug/Core.Cli"
            }
        },
        {
            "name": "az: help",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "--help"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal",
            "env": {
                "AZURE_CLI_EXTENSION_DIRECTORY": "${workspaceFolder}/artifacts/Debug/Core.Cli"
            }
        }
    ]
}