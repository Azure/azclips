{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "C#: group create Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "group",
                "create",
                "--Subscription-Id",
                "9e223dbe-3399-4e19-88eb-0975f02ac87f",
                "--Name",
                "yabo-test-group-1",
                "--Location",
                "eastus"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core",
            "console": "integratedTerminal"
        },
        {
            "name": "C#: group show Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "group",
                "create",
                "--name",
                "test-rg",
                "--location",
                "eastus",
                "--subscription-id",
                "00000000-0000-0000-0000-000000000000",
                "--access-token",
                "placeholder-token"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "C#: login show Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "login",
                "show"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "C#: logout Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "login",
                "logout",
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "az: help",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "--help"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "az: interactive",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "${input:azArg1}",
                "${input:azArg2}",
                "${input:azArg3}"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "azArg1",
            "type": "promptString",
            "description": "Enter az argument 1 (e.g. help, group, login)"
        },
        {
            "id": "azArg2",
            "type": "promptString",
            "description": "Enter az argument 2 if needed (e.g. list, show, create)"
        },
        {
            "id": "azArg3",
            "type": "promptString",
            "description": "Enter az argument 3 if needed"
        }
    ]
}
