{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "C#: group create Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "group",
                "create",
                "--Subscription-Id",
                "9e223dbe-3399-4e19-88eb-0975f02ac87f",
                "--Name",
                "yabo-test-group-1",
                "--Location",
                "eastus"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core",
            "console": "integratedTerminal"
        },
        {
            "name": "C#: group show Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "group",
                "create",
                "--name",
                "test-rg",
                "--location",
                "eastus",
                "--subscription-id",
                "00000000-0000-0000-0000-000000000000",
                "--access-token",
                "placeholder-token"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "C#: login show Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "login",
                "show"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "C#: logout Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "login",
                "logout",
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "az: help",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "--help"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "az: interactive",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            "program": "${workspaceFolder}/artifacts/Debug/Core.Cli/az",
            "args": [
                "${input:azArg1}",
                "${input:azArg2}",
                "${input:azArg3}"
            ],
            "cwd": "${workspaceFolder}/artifacts/Debug/Core.Cli",
            "console": "integratedTerminal"
        },
        {
            "name": "toolkit: debug vitest file",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/toolkit/node_modules/vitest/vitest.mjs",
            "args": ["run", "${input:toolkitTestFile}", "--no-file-parallelism"],
            "cwd": "${input:toolkitPackageDir}",
            "console": "integratedTerminal",
            "smartStep": true,
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
        },
        {
            "name": "toolkit: debug ace compile (create-ps-commands + generate-ps-commands)",
            "type": "node",
            "request": "launch",
            "preLaunchTask": "toolkit: build",
            "program": "${workspaceFolder}/toolkit/packages/cli/dist/src/cli.js",
            "args": [
                "compile",
                "--tsp-location",
                "${workspaceFolder}/toolkit/packages/typespec-emitter/test/fixtures/fleet/main.tsp",
                "--config",
                "${workspaceFolder}/toolkit/.debug/generate-ps-commands.config.json",
                "--out-dir",
                "${workspaceFolder}/toolkit/.debug/out"
            ],
            "cwd": "${workspaceFolder}/toolkit",
            "console": "integratedTerminal",
            "outFiles": ["${workspaceFolder}/toolkit/packages/*/dist/**/*.js"],
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
        }
    ],
    "inputs": [
        {
            "id": "toolkitTestFile",
            "type": "promptString",
            "description": "Test file to debug, relative to its package (e.g. test/fleet.e2e.test.ts)",
            "default": "test/fleet.e2e.test.ts"
        },
        {
            "id": "toolkitPackageDir",
            "type": "promptString",
            "description": "Package directory containing that test (e.g. ${workspaceFolder}/toolkit/packages/cli)",
            "default": "${workspaceFolder}/toolkit/packages/cli"
        },
        {
            "id": "azArg1",
            "type": "promptString",
            "description": "Enter az argument 1 (e.g. help, group, login)"
        },
        {
            "id": "azArg2",
            "type": "promptString",
            "description": "Enter az argument 2 if needed (e.g. list, show, create)"
        },
        {
            "id": "azArg3",
            "type": "promptString",
            "description": "Enter az argument 3 if needed"
        }
    ]
}
