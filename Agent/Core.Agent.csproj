<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>azclips-agent</AssemblyName>
    <RootNamespace>Core.Agent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;GHCP001</WarningsNotAsErrors>
    <ExtName>Core.Agent</ExtName>
    <!-- Compile-time marker for AgentInstallLayout. Packaging scripts publish
         with /p:IsPackagedBuild=true; dev `dotnet build` / `dotnet run` / F5
         never pass it, so dev binaries carry AGENT_DEV_BUILD and packaged
         binaries do not. Each dll's flavor is baked in at compile time — an
         MSI-installed agent and a locally-built one on the same box can never
         confuse each other, because each looks only at its own `#if`. -->
    <DefineConstants Condition="'$(IsPackagedBuild)' != 'true'">$(DefineConstants);AGENT_DEV_BUILD</DefineConstants>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\Shared.props" />

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <!-- Commands/ is its own extension project (Agent.Commands.csproj); do not
         include its sources in the Core.Agent exe build. -->
    <Compile Remove="Commands\**" />
    <None Remove="Commands\**" />
    <Content Remove="Commands\**" />
    <EmbeddedResource Remove="Commands\**" />
    <!-- Tools/ is its own class library (Core.Agent.Tools.csproj) that the
         extension and this exe both consume via ProjectReference below. -->
    <Compile Remove="Tools\**" />
    <None Remove="Tools\**" />
    <Content Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />

    <!-- eval/ holds the promptfoo-based evaluation harness (test-only, run via
         its own script). Exclude so it never ships in the packaged agent. -->
    <Compile Remove="eval\**" />
    <None Remove="eval\**" />
    <Content Remove="eval\**" />
    <EmbeddedResource Remove="eval\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.ResourceManager" Version="1.13.1" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.13" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.10.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Core\Core.Abstractions\Core.Abstractions.csproj" />
    <!-- AgentModeEntry (moved from TUI) needs the DI container + scoped logging.
         These follow the code: they were on Core.Tui when the entry lived there. -->
    <ProjectReference Include="..\src\Core\Core.DependencyInjection\Core.DependencyInjection.csproj" />
    <ProjectReference Include="..\src\Core\Core.Runtime\Core.Runtime.csproj" />
    <!-- Agent tool implementations (EnvironmentProber / HelpTools /
         CachedResourceTools / AvailableLocationsTool) live in their own class
         library so Agent.Commands (the extension) can consume them without
         pulling in the whole azclips-agent.exe assembly. -->
    <ProjectReference Include="Tools\Core.Agent.Tools.csproj" />
    <!-- Agent code calls types in az.dll (help contracts), so az.dll must be in the deps.json.
         Build Core.Cli without the RID so a RID publish reuses the build that Core.Agent.Tools also uses. -->
    <ProjectReference Include="..\src\CLI\Core.Cli.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- Core.Cli is an exe with content of its own. From it the agent needs only az.dll.
       These items match the CLI apphost, deps.json and runtimeconfig files by output path. -->
  <ItemGroup>
    <_CliHostFile Include="az.exe;az;az.deps.json;az.runtimeconfig.json;az.runtimeconfig.dev.json" TargetPath="%(Identity)" RelativePath="%(Identity)" />
  </ItemGroup>
  <!-- Build: do not copy the CLI host files, help/ or completions/ into the agent output. -->
  <Target Name="RemoveCliFilesFromBuildOutput" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_CliContentToRemove Include="@(AllItemsFullPathWithTargetPath)" Condition="$([System.String]::Copy('%(TargetPath)').Replace('\', '/').StartsWith('help/')) or $([System.String]::Copy('%(TargetPath)').Replace('\', '/').StartsWith('completions/'))" />
      <_CliContentToRemove Include="@(_CliHostFile)" />
      <_TransitiveItemsToCopyToOutputDirectory Remove="@(_CliContentToRemove)" MatchOnMetadata="TargetPath" />
      <AllItemsFullPathWithTargetPath Remove="@(_CliContentToRemove)" MatchOnMetadata="TargetPath" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_CliContentToRemove)" MatchOnMetadata="TargetPath" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_CliContentToRemove)" MatchOnMetadata="TargetPath" />
    </ItemGroup>
  </Target>
  <!-- Publish: also drop az.dll. The packaged agent relies on the CLI install root to provide az.dll. -->
  <Target Name="RemoveCliFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CliFileToNotPublish Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'az.dll' or $([System.String]::Copy('%(RelativePath)').Replace('\', '/').StartsWith('help/')) or $([System.String]::Copy('%(RelativePath)').Replace('\', '/').StartsWith('completions/'))" />
      <_CliFileToNotPublish Include="@(_CliHostFile)" />
      <ResolvedFileToPublish Remove="@(_CliFileToNotPublish)" MatchOnMetadata="RelativePath" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- These files are already picked up as None items by the SDK's default glob
         (EnableDefaultNoneItems=true); Update just sets CopyToOutputDirectory on them.
         If default-item collection is ever disabled, switch these to Include (and add
         EnableDefaultNoneItems=false) so prompts still reach the output dir. -->
    <None Update="prompts\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update=".env" Condition="Exists('.env')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <InternalsVisibleTo Include="Core.Agent.Tests" Key="$(MSSharedLibPublicKey)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <InternalsVisibleTo Include="Core.Agent.Tests" />
  </ItemGroup>

</Project>
