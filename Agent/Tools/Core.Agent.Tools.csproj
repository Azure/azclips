<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Azclips.Agent.Tools</AssemblyName>
    <RootNamespace>Core.Agent.Tools</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <ExtName>Core.Agent.Tools</ExtName>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Shared.props" />

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <PackageReference Include="Azure.ResourceManager" Version="1.13.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.Abstractions\Core.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HelpTools reads these JSON corpus files from the assembly's own
         directory at runtime. Link them into a Help/ subdir at output so
         both the standalone azclips-agent.exe host and the az agent tool
         extension host find them next to Core.Agent.Tools.dll. -->
    <None Include="Help\*.json">
      <Link>Help\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Core.Agent.Tests" />
  </ItemGroup>

</Project>
