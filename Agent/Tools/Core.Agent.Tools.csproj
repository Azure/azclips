<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Azclips.Agent.Tools</AssemblyName>
    <RootNamespace>Core.Agent.Tools</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <ExtName>Core.Agent.Tools</ExtName>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Shared.props" />

  <ItemGroup>
    <PackageReference Include="Azure.ResourceManager" Version="1.13.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.Abstractions\Core.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Core\Core.Configuration\Core.Configuration.csproj" />
    <!-- Help catalog contracts (Core.Cli.Help) and extension discovery paths shared with the CLI host.
         Compile-time only for this library. The agent exe (Agent/Core.Agent.csproj) references Core.Cli
         normally so az.dll is in azclips-agent.deps.json; in the az process the CLI host provides az.dll. -->
    <ProjectReference Include="..\..\src\CLI\Core.Cli.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <InternalsVisibleTo Include="Core.Agent.Tests" Key="$(MSSharedLibPublicKey)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <InternalsVisibleTo Include="Core.Agent.Tests" />
  </ItemGroup>

</Project>
