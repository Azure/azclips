{
  "version": "1.0.0-alpha",
  "commands": [
    {
      "name": "LoginProcessor",
      "cliName": "login",
      "psName": "Connect-AzAccount",
      "extension": "login",
      "group": "login",
      "summary": "Authenticate to Azure and set the current account context.",
      "description": "Authenticate to Azure and persist account context for subsequent commands.",
      "parameters": [
        {
          "cliName": "subscription-id",
          "psName": "SubscriptionId",
          "type": "string",
          "required": true,
          "description": "Azure Subscription Id."
        },
        {
          "cliName": "tenant-id",
          "psName": "TenantId",
          "type": "string",
          "required": false,
          "description": "Tenant ID to login to."
        },
        {
          "cliName": "use-device-code",
          "psName": "UseDeviceCode",
          "type": "bool",
          "required": false,
          "description": "Use device code flow for authentication."
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "Login with subscription id",
            "command": "az login --subscription-id 00000000-0000-0000-0000-000000000000"
          },
          {
            "title": "Login with device code",
            "command": "az login --subscription-id 00000000-0000-0000-0000-000000000000 --use-device-code"
          }
        ],
        "powerShell": [
          {
            "title": "Login with subscription id",
            "command": "Connect-AzAccount -SubscriptionId 00000000-0000-0000-0000-000000000000"
          },
          {
            "title": "Login with device code",
            "command": "Connect-AzAccount -SubscriptionId 00000000-0000-0000-0000-000000000000 -UseDeviceCode"
          }
        ]
      }
    },
    {
      "name": "LogoutProcessor",
      "cliName": "login logout",
      "psName": "Disconnect-AzAccount",
      "extension": "login",
      "group": "login",
      "summary": "Sign out from the current Azure account context.",
      "description": "Sign out from the current Azure account context.",
      "parameters": [],
      "examples": {
        "cli": [{ "title": "Sign out", "command": "az login logout" }],
        "powerShell": [
          { "title": "Sign out", "command": "Disconnect-AzAccount" }
        ]
      }
    },
    {
      "name": "GetContextProcessor",
      "cliName": "login show",
      "psName": "Get-AzAccount",
      "extension": "login",
      "group": "login",
      "summary": "Show the current Azure account context.",
      "description": "Show the current Azure account context.",
      "parameters": [],
      "examples": {
        "cli": [
          { "title": "Show current account", "command": "az login show" }
        ],
        "powerShell": [
          { "title": "Show current account", "command": "Get-AzAccount" }
        ]
      }
    },

    {
      "name": "NewResourceGroupProcessor",
      "cliName": "group create",
      "psName": "New-ResourceGroup",
      "extension": "resources",
      "group": "group",
      "summary": "Create a new resource group.",
      "description": "Provision a new resource group in your Azure subscription. Specify the resource group name, location (region), and subscription ID. An optional resource ID can be provided for advanced scenarios.",
      "parameters": [
        {
          "cliName": "subscription-id",
          "psName": "SubscriptionId",
          "type": "string",
          "required": true,
          "description": "Azure Subscription Id."
        },
        {
          "cliName": "name",
          "psName": "Name",
          "type": "string",
          "required": true,
          "description": "The name of the resource group."
        },
        {
          "cliName": "location",
          "psName": "Location",
          "type": "string",
          "required": true,
          "description": "Location for the resource group."
        },
        {
          "cliName": "resource-id",
          "psName": "ResourceId",
          "type": "string",
          "required": false,
          "description": "The resource id of the resource group."
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "Create in East US",
            "command": "az group create --name myresourcegroup --location eastus --subscription-id 00000000-0000-0000-0000-000000000000"
          },
          {
            "title": "Create with explicit resource id",
            "command": "az group create --name myrg --location westus --resource-id /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myrg --subscription-id 00000000-0000-0000-0000-000000000000"
          }
        ],
        "powerShell": [
          {
            "title": "Create a resource group",
            "command": "New-ResourceGroup -Name \"myresourcegroup\" -Location \"eastus\" -SubscriptionId \"00000000-0000-0000-0000-000000000000\""
          }
        ]
      }
    },
    {
      "name": "ListResourceGroupProcessor",
      "cliName": "group list",
      "psName": "Get-ResourceGroup_List",
      "extension": "resources",
      "group": "group",
      "summary": "List all resource groups in a subscription.",
      "description": "Retrieve a list of all resource groups in the specified Azure subscription. If no subscription ID is provided, the default subscription from the current login context is used.",
