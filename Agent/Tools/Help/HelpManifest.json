          "cliName": "subscription-id",
          "psName": "SubscriptionId",
          "type": "string",
          "required": false,
          "description": "Azure Subscription Id. Defaults to current login context."
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "List with explicit subscription",
            "command": "az group list --subscription-id 00000000-0000-0000-0000-000000000000"
          },
          {
            "title": "List using default subscription",
            "command": "az group list"
          }
        ],
        "powerShell": [
          {
            "title": "List with explicit subscription",
            "command": "Get-ResourceGroup_List -SubscriptionId \"00000000-0000-0000-0000-000000000000\""
          },
          {
            "title": "List using default subscription",
            "command": "Get-ResourceGroup_List"
          }
        ]
      }
    },
    {
