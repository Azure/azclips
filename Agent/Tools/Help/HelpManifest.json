          "cliName": "subnet-address-prefixes",
          "psName": "SubnetAddressPrefixes",
          "type": "list<list<string>>",
          "required": false,
          "description": "Address prefixes for each subnet."
        },
        {
          "cliName": "address-prefixes",
          "psName": "AddressPrefixes",
          "type": "list<string>",
          "required": false,
          "description": "Address prefixes for the virtual network."
        },
        {
          "cliName": "rule-names",
          "psName": "RuleNames",
          "type": "list<string>",
          "required": false,
          "description": "Names of the security rules."
        },
        {
          "cliName": "rule-directions",
          "psName": "RuleDirections",
          "type": "list<string>",
          "required": false,
          "description": "Directions of the security rules."
        },
        {
          "cliName": "rule-protocols",
          "psName": "RuleProtocols",
          "type": "list<string>",
          "required": false,
          "description": "Protocols of the security rules."
        },
        {
          "cliName": "rule-priorities",
          "psName": "RulePriorities",
          "type": "list<int>",
          "required": false,
          "description": "Priorities of the security rules."
        },
        {
          "cliName": "rule-source-address-prefixes",
          "psName": "RuleSourceAddressPrefixes",
          "type": "list<string>",
          "required": false,
          "description": "Source address prefixes of the security rules."
        },
        {
          "cliName": "rule-source-port-ranges",
          "psName": "RuleSourcePortRanges",
          "type": "list<string>",
          "required": false,
          "description": "Source port ranges of the security rules."
        },
        {
          "cliName": "rule-destination-port-ranges",
          "psName": "RuleDestinationPortRanges",
          "type": "list<string>",
          "required": false,
          "description": "Destination port ranges of the security rules."
        },
        {
          "cliName": "rule-destination-address-prefixes",
          "psName": "RuleDestinationAddressPrefixes",
          "type": "list<string>",
          "required": false,
          "description": "Destination address prefixes of the security rules."
        },
        {
          "cliName": "rule-accesses",
          "psName": "RuleAccesses",
          "type": "list<string>",
          "required": false,
          "description": "Access types (Allow/Deny) of the security rules."
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "Create VM with combined networking",
            "command": "az vm create --name myvm --location eastus --resource-group myrg --subscription-id 00000000-0000-0000-0000-000000000000 --vm-size Standard_D2s_v3 --admin-username azureuser --admin-password <password> --network-interface-name mynic --virtual-network-name myvnet --network-security-group-name mynsg"
          },
          {
            "title": "Create with explicit subnet and address prefixes",
            "command": "az vm create --name myvm --location eastus --resource-group myrg --subscription-id 00000000-0000-0000-0000-000000000000 --vm-size Standard_D2s_v3 --admin-username azureuser --admin-password <password> --network-interface-name mynic --virtual-network-name myvnet --network-security-group-name mynsg --subnet-names default --address-prefixes 10.0.0.0/16"
          }
        ],
        "powerShell": [
          {
            "title": "Create VM with combined networking",
            "command": "New-VM -SubscriptionId \"00000000-0000-0000-0000-000000000000\" -Name \"myvm\" -Location \"eastus\" -ResourceGroupName \"myrg\" -VmSize \"Standard_D2s_v3\" -AdminUsername \"azureuser\" -AdminPassword \"<password>\" -NetworkInterfaceName \"mynic\" -VirtualNetworkName \"myvnet\" -NetworkSecurityGroupName \"mynsg\""
          }
        ]
      }
