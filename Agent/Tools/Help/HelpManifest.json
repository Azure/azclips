    {
      "name": "GetConfigCommand",
      "cliName": "config get",
      "psName": "Get-AzConfig",
      "extension": "config",
      "group": "config",
      "summary": "Retrieve a configuration value.",
      "description": "Get the current value of a configuration setting by key. Configuration keys use dot notation (e.g., output.format, core.debug). If the key is not found, an error is displayed.",
      "parameters": [
        {
          "cliName": "key",
          "psName": "Key",
          "type": "string",
          "required": true,
          "description": "Configuration key in dot notation."
        },
        {
          "cliName": "json",
          "psName": "AsJson",
          "type": "bool",
          "required": false,
          "description": "Output as JSON."
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "Get output format setting",
            "command": "az config get output.format"
          },
          {
            "title": "Get output as JSON",
            "command": "az config get output.format --json"
          }
        ],
        "powerShell": [
          {
            "title": "Get a configuration value",
            "command": "Get-AzConfig -Key \"output.format\""
          }
        ]
      }
    },
    {
      "name": "SetConfigCommand",
      "cliName": "config set",
      "psName": "Set-AzConfig",
      "extension": "config",
      "group": "config",
      "summary": "Set or update a configuration value.",
      "description": "Set a configuration value using dot notation keys. If the key already exists, it will be updated. Unknown keys are rejected unless -Force is specified.",
      "parameters": [
        {
          "cliName": "key",
          "psName": "Key",
          "type": "string",
          "required": true,
          "description": "Configuration key in dot notation."
        },
        {
          "cliName": "value",
          "psName": "Value",
          "type": "string",
          "required": true,
          "description": "Configuration value."
        },
        {
          "cliName": "force",
          "psName": "Force",
          "type": "bool",
          "required": false,
          "description": "Allow unknown keys."
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "Set output format to JSON",
            "command": "az config set output.format json"
          },
          {
            "title": "Set a custom key with force",
            "command": "az config set custom.mykey myvalue --force"
          }
        ],
        "powerShell": [
          {
            "title": "Set output format",
            "command": "Set-AzConfig -Key \"output.format\" -Value \"json\""
          },
          {
            "title": "Set custom key with force",
            "command": "Set-AzConfig -Key \"custom.mykey\" -Value \"myvalue\" -Force"
          }
        ]
      }
    },
    {
      "name": "DeleteConfigCommand",
      "cliName": "config delete",
      "psName": "Remove-AzConfig",
      "extension": "config",
      "group": "config",
      "summary": "Delete a configuration value.",
      "description": "Remove a configuration setting by key. Once deleted, the setting reverts to its default value (if one exists). Unknown keys are rejected unless -Force is specified.",
      "parameters": [
        {
          "cliName": "key",
          "psName": "Key",
          "type": "string",
          "required": true,
          "description": "Configuration key in dot notation."
        },
        {
          "cliName": "force",
          "psName": "Force",
          "type": "bool",
          "required": false,
          "description": "Allow unknown keys."
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "Delete a configuration setting",
            "command": "az config delete custom.mykey"
          },
          {
            "title": "Force delete without validation",
            "command": "az config delete custom.mykey --force"
          }
        ],
        "powerShell": [
          {
            "title": "Delete a configuration value",
            "command": "Remove-AzConfig -Key \"custom.mykey\""
          },
          {
            "title": "Force delete",
            "command": "Remove-AzConfig -Key \"custom.mykey\" -Force"
          }
        ]
      }
    },
    {
      "name": "ListConfigCommand",
      "cliName": "config list",
      "psName": "Get-AzConfigList",
      "extension": "config",
      "group": "config",
      "summary": "List all configuration settings.",
      "description": "Display all current configuration values. By default, only explicitly-set values are shown. Use --all (CLI) / -IncludeDefaults (PS) to include default values.",
      "parameters": [
        {
          "cliName": "all",
          "psName": "IncludeDefaults",
          "type": "bool",
          "required": false,
          "description": "Include default values."
        },
        {
          "cliName": "json",
          "psName": "AsJson",
          "type": "bool",
          "required": false,
          "description": "Output as JSON."
        }
      ],
      "examples": {
        "cli": [
          { "title": "List current values", "command": "az config list" },
          {
            "title": "List including defaults",
            "command": "az config list --all"
          },
          { "title": "List as JSON", "command": "az config list --json" }
        ],
        "powerShell": [
          { "title": "List all configuration", "command": "Get-AzConfigList" },
          {
            "title": "List with defaults",
            "command": "Get-AzConfigList -IncludeDefaults"
          }
        ]
      }
    },
    {
      "name": "InfoConfigCommand",
      "cliName": "config info",
      "psName": "Get-AzConfigInfo",
      "extension": "config",
      "group": "config",
      "summary": "Display information about valid configuration keys.",
      "description": "Show metadata about available configuration keys including their descriptions, default values, and allowed value constraints.",
      "parameters": [
        {
          "cliName": "keys-only",
          "psName": "KeysOnly",
          "type": "bool",
          "required": false,
          "description": "Return only valid key names."
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "Display configuration schema",
            "command": "az config info"
          },
          {
            "title": "Display only valid key names",
            "command": "az config info --keys-only"
          }
        ],
        "powerShell": [
          {
            "title": "Display configuration schema",
            "command": "Get-AzConfigInfo"
          },
          {
            "title": "Display only key names",
            "command": "Get-AzConfigInfo -KeysOnly"
          }
        ]
      }
    },

