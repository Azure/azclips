<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../../../src/MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core.Agent.csproj" />
    <ProjectReference Include="..\..\..\tests\Common\Tests.Common.csproj" />
    <!-- Exercise the production catalog generator and command registration. -->
    <ProjectReference Include="..\..\Commands\Agent.Commands.csproj" />
    <ProjectReference Include="..\..\..\src\CLI\Core.Cli.csproj" />
    <ProjectReference Include="..\..\..\tests\Fixtures\SharedAlpha\Azclips.Tests.Fixtures.SharedAlpha.csproj" />
    <ProjectReference Include="..\..\..\tests\Fixtures\SharedBeta\Azclips.Tests.Fixtures.SharedBeta.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Snapshot baselines: copy alongside the test dll so SnapshotAssert
         can locate them via its walk-up-from-test-bin search. -->
    <None Update="Snapshots\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
