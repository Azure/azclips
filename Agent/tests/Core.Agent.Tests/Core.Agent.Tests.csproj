<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../../../src/MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- ArmDetailsClientLocalTests references AzureCliCredential, which
         Azure.Core 1.54+ and Azure.Identity 1.13.2 both expose in the
         Azure.Identity namespace. C# cannot disambiguate without extern
         aliases. The tests are already [Fact(Skip=Local-only)] so excluding
         the file from compilation costs nothing: developers who want the
         local ARM smoke tests re-include it locally. -->
    <Compile Remove="ArmDetailsClientLocalTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core.Agent.csproj" />
    <ProjectReference Include="..\..\..\tests\Common\Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Snapshot baselines: copy alongside the test dll so SnapshotAssert
         can locate them via its walk-up-from-test-bin search. -->
    <None Update="Snapshots\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

