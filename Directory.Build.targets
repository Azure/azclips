<Project>
  <ItemGroup>
    <PackageReference Update="System.Management.Automation;Microsoft.PowerShell.SDK" Version="7.6.7" />

    <!--
      Security pin for transitive System.Security.Cryptography.Pkcs.
      Chains (as of 2026-10):
        System.Management.Automation 7.6.7 -> Pkcs >= 10.0.5 (Microsoft.PowerShell.SDK depends on it)
        NuGet.Packaging 7.3.1 (latest 7.9.0) -> Pkcs >= 8.0.1
      Why: NuGet resolves those lowest allowed versions, which are vulnerable to
        GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx (patched in 10.0.13 / 8.0.2).
      Unpin when: every listed package requires a patched Pkcs version. Remove this item, then confirm
        `dotnet list azclips.slnx package` (vulnerable + include-transitive options) reports nothing vulnerable.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13"
                      Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'System.Management.Automation'))
                              Or @(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.PowerShell.SDK'))
                              Or @(PackageReference->AnyHaveMetadataValue('Identity', 'NuGet.Packaging'))" />

    <!--
      Security pin for the existing System.Security.Cryptography.Xml reference in Benchmark.
      Chain: Microsoft.PowerShell.SDK 7.6.7 -> Xml >= 10.0.10.
      Why: 10.0.10 is vulnerable to GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, and GHSA-r955-8q5j-3h83
        (patched in 10.0.13).
      Unpin when: Microsoft.PowerShell.SDK requires Xml >= 10.0.13. Then remove this item and the
        Benchmark reference, and re-run the same audit.
    -->
    <PackageReference Update="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
</Project>
