<?xml version="1.0" encoding="utf-8"?>
<!--
  Package restore is routed through the approved Microsoft package feed proxy
  (Central Feed Services) instead of api.nuget.org.

  Per Microsoft policy, direct access to public NuGet endpoints (api.nuget.org,
  nuget.org/api/v2) is blocked on Microsoft-managed devices. The proxy below is
  a transparent mirror of nuget.org, is anonymously reachable, and works from
  both managed devices and public CI runners.

  Docs: https://eng.ms/docs/coreai/devdiv/one-engineering-system-1es/1es-docs/secure-supply-chain/central-feed-services-cfs/cfs-policy-and-feed-enforcement-exceptions
-->
<configuration>
  <packageSources>
    <clear />
    <add key="CFS" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" />
  </packageSources>
</configuration>
