<Project>
  <PropertyGroup>
    <Product>Azclips</Product>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <RepoSrc>$(RepoRoot)src/</RepoSrc>
    <RepoArtifacts>$(RepoRoot)artifacts/</RepoArtifacts>
    <RepoTools>$(RepoRoot)tools/</RepoTools>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(RepoArtifacts)$(Configuration)/$(ExtName)/</OutputPath>
    <PublishDir>$(OutputPath)</PublishDir>
    <!-- todo: align assembly name e.g. <AssemblyName>$(AzAssemblyPrefix)$(ExtName)</AssemblyName> -->
  </PropertyGroup>

  <!-- Strong-name (delay-sign) configuration, mirroring Azure PowerShell.
       Debug: no delay-signing so dev/test builds load normally.
       Release: delay-sign with the Microsoft shared public key. The matching
       private key (MSSharedLibSN1024key) is applied by ESRP StrongNameSign. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DelaySign>false</DelaySign>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>$(RepoSrc)MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
    <MSSharedLibPublicKey></MSSharedLibPublicKey>
  </PropertyGroup>

  <ItemGroup>
    <!-- PowerShell assets -->
    <None Update="*.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="*.ps1xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
