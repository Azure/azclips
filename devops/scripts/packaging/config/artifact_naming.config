# artifact_naming.config
# Default release asset naming policy.
# Scripts use these values unless environment variables override them.

cli_archive_stem=azcli
cli_lean_archive_stem=azcli-lean
artifact_version_suffix=
cli_extensions_archive_stem=azcli-extensions
ps_cmdlets_archive_stem=azps-cmdlets
github_release_name_suffix=(Public Preview)

linux_x64_label=linux-x64
linux_arm64_label=linux-arm64
linux_musl_x64_label=linux-musl-x64
linux_musl_arm64_label=linux-musl-arm64
windows_x64_label=win-x64
windows_arm64_label=win-arm64
macos_arm64_label=macos-arm64
macos_x64_label=macos-x86_64
