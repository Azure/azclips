ARG BASE_IMAGE=mcr.microsoft.com/dotnet/runtime-deps:10.0-azurelinux3.0
FROM ${BASE_IMAGE}

ARG AZCLIPS_UID=10001
ARG AZCLIPS_GID=10001

RUN tdnf install -y shadow-utils \
    && groupadd --system --gid "${AZCLIPS_GID}" azclips \
    && useradd --system --uid "${AZCLIPS_UID}" --gid azclips \
        --create-home --shell /sbin/nologin azclips \
    && tdnf autoremove -y shadow-utils \
    && tdnf clean all

COPY --chown=azclips:azclips cli/ /app/

ENV PATH="/app:${PATH}" \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

USER azclips
WORKDIR /home/azclips

ENTRYPOINT ["/app/az"]
CMD ["--help"]
