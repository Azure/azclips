# Azure OpenAI Configuration (for CloudAgent)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Azure Copilot Configuration (for AzureCopilotAgent)
# Environment: local, temp, test, dev, beta, prod, ppe
AZURE_COPILOT_ENV=temp

# Region: eus (East US), weu (West Europe)
AZURE_COPILOT_REGION=eus

# Copilot Type: azps (Azure PowerShell), azcli (Azure CLI), aztf (Terraform)
AZURE_COPILOT_TYPE=azps

# IMPORTANT: Specify your Microsoft tenant ID for Azure Copilot authentication
# This is required to access the Azure Copilot API
# Get your tenant ID from: https://portal.azure.com/ -> Azure Active Directory -> Properties
AZURE_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47

# Optional: Use service principal authentication (alternative to device code)
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
