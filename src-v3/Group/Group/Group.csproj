<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtName>Group</ExtName>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\Core.Abstractions\Core.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Include Business, Commands, and Cmdlets folders from parent directory -->
  <ItemGroup>
    <Compile Include="..\Business\**\*.cs" />
    <Compile Include="..\Commands\**\*.cs" />
    <Compile Include="..\Cmdlets\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" />
  </ItemGroup>

</Project>
