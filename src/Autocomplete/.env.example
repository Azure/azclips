# Azure OpenAI configuration for the autocomplete agent.
# Iteration 1 uses API key auth.
#
# Dedicated variables (preferred):
AZURE_OPENAI_AUTOCOMPLETE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_AUTOCOMPLETE_DEPLOYMENT=gpt-5x-nano
AZURE_OPENAI_AUTOCOMPLETE_API_KEY=YOUR-KEY

# Optional fallbacks (shared with the main agent if dedicated vars are absent):
# AZURE_OPENAI_ENDPOINT=...
# AZURE_OPENAI_DEPLOYMENT=...
# AZURE_OPENAI_API_KEY=...

# Optional tuning:
# AZV2_AUTOCOMPLETE_MAX_SUGGESTIONS=12
# AZV2_AUTOCOMPLETE_TIMEOUT_MS=1500
