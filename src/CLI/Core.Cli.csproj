<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>azv2</AssemblyName>
    <RootNamespace>Core.Cli</RootNamespace>
    <ExtName>Core.Cli</ExtName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Az Command-Line Interface</AssemblyTitle>
    <AssemblyDescription>A command-line tool for dynamically loading extensions and processing commands.</AssemblyDescription>
    <Version>0.1.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Copyright>Copyright © 2025</Copyright>
    <StartupObject>Core.Cli.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cli.Tests" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.DependencyInjection\Core.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
  </ItemGroup>



</Project>
