<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>az</AssemblyName>
    <RootNamespace>Core.Cli</RootNamespace>
    <ExtName>Core.Cli</ExtName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Az Command-Line Interface</AssemblyTitle>
    <AssemblyDescription>A command-line tool for dynamically loading extensions and processing commands.</AssemblyDescription>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <InformationalVersion>0.1.4</InformationalVersion>
    <Copyright>Copyright © 2025</Copyright>
    <StartupObject>Core.Cli.Program</StartupObject>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Shared.props" />
  <Import Project="$(MSBuildThisFileDirectory)Targets\ExtensionHints.targets" />

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <InternalsVisibleTo Include="Cli.Tests" Key="$(MSSharedLibPublicKey)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <InternalsVisibleTo Include="Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.DependencyInjection\Core.DependencyInjection.csproj" />
    <ProjectReference Include="..\Core\Core.Extensions\Core.Extensions.csproj" />
  </ItemGroup>

  <!--
    Authored CLI help markdown ships next to the az binary. Runtime resolution
    is filesystem-based (MarkdownCommandHelpProvider) — primary path is
    <output>/help/<ext>/<key>.md, with a repo-root fallback for the dev loop.
    Source lives under Help/Docs/; <Link> flattens the Docs/ segment so the
    packaged path remains help/<ext>/<key>.md.
  -->
  <ItemGroup>
    <Content Include="Help\Docs\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>help\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Completions\**\*" Exclude="Completions\**\*.cs;Completions\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>completions\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.3.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="JmesPath.Net" Version="1.1.0" />
  </ItemGroup>

</Project>
