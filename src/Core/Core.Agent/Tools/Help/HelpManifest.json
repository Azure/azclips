    {
      "name": "GetConfigCommand",
      "cliName": "config get",
      "psName": "Get-CirrusConfig",
      "extension": "config",
      "group": "config",
      "summary": "Retrieve a configuration value.",
      "description": "Get the current value of a configuration setting by key. Configuration keys use dot notation (e.g., output.format, core.debug). If the key is not found, an error is displayed.",
      "parameters": [
        { "cliName": "key", "psName": "Key", "type": "string", "required": true, "description": "Configuration key in dot notation." },
        { "cliName": "json", "psName": "Json", "type": "bool", "required": false, "description": "Output as JSON." }
      ],
      "examples": {
        "cli": [
          { "title": "Get output format setting", "command": "azv2 config get output.format" },
          { "title": "Get output as JSON", "command": "azv2 config get output.format --json" }
        ],
        "powerShell": [
          { "title": "Get a configuration value", "command": "Get-CirrusConfig -Key \"output.format\"" }
        ]
      }
    },
    {
      "name": "SetConfigCommand",
      "cliName": "config set",
      "psName": "Set-CirrusConfig",
      "extension": "config",
      "group": "config",
      "summary": "Set or update a configuration value.",
      "description": "Set a configuration value using dot notation keys. If the key already exists, it will be updated. Unknown keys are rejected unless --force is specified.",
      "parameters": [
        { "cliName": "key", "psName": "Key", "type": "string", "required": true, "description": "Configuration key in dot notation." },
        { "cliName": "value", "psName": "Value", "type": "string", "required": true, "description": "Configuration value." },
        { "cliName": "force", "psName": "Force", "type": "bool", "required": false, "description": "Allow unknown keys." }
      ],
      "examples": {
        "cli": [
          { "title": "Set output format to JSON", "command": "azv2 config set output.format json" },
          { "title": "Set a custom key with force", "command": "azv2 config set custom.mykey myvalue --force" }
        ],
        "powerShell": [
          { "title": "Set output format", "command": "Set-CirrusConfig -Key \"output.format\" -Value \"json\"" },
          { "title": "Set custom key with force", "command": "Set-CirrusConfig -Key \"custom.mykey\" -Value \"myvalue\" -Force" }
        ]
      }
    },
    {
      "name": "DeleteConfigCommand",
      "cliName": "config delete",
      "psName": "Remove-CirrusConfig",
      "extension": "config",
      "group": "config",
      "summary": "Delete a configuration value.",
      "description": "Remove a configuration setting by key. Once deleted, the setting reverts to its default value (if one exists). Unknown keys are rejected unless --force is specified.",
      "parameters": [
