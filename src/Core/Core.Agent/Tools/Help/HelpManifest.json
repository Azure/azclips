{
  "version": "1.0.0-alpha",
  "commands": [
    {
      "name": "LoginProcessor",
      "cliName": "login",
      "psName": "Connect-CirrusAccount",
      "extension": "login",
      "group": "login",
      "summary": "Authenticate to Azure and set the current account context.",
      "description": "Authenticate to Azure and persist account context for subsequent commands.",
      "parameters": [
        { "cliName": "subscription-id", "psName": "SubscriptionId", "type": "string", "required": true, "description": "Azure Subscription Id." },
        { "cliName": "tenant-id", "psName": "TenantId", "type": "string", "required": false, "description": "Tenant ID to login to." },
        { "cliName": "use-device-code", "psName": "UseDeviceCode", "type": "bool", "required": false, "description": "Use device code flow for authentication." }
      ],
      "examples": {
        "cli": [
          { "title": "Login with subscription id", "command": "azv2 login --subscription-id 00000000-0000-0000-0000-000000000000" },
          { "title": "Login with device code", "command": "azv2 login --subscription-id 00000000-0000-0000-0000-000000000000 --use-device-code" }
        ],
        "powerShell": [
          { "title": "Login with subscription id", "command": "Connect-CirrusAccount -SubscriptionId 00000000-0000-0000-0000-000000000000" },
          { "title": "Login with device code", "command": "Connect-CirrusAccount -SubscriptionId 00000000-0000-0000-0000-000000000000 -UseDeviceCode" }
        ]
      }
    },
    {
      "name": "LogoutProcessor",
      "cliName": "login logout",
      "psName": "Disconnect-CirrusAccount",
      "extension": "login",
      "group": "login",
      "summary": "Sign out from the current Azure account context.",
      "description": "Sign out from the current Azure account context.",
      "parameters": [],
      "examples": {
        "cli": [ { "title": "Sign out", "command": "azv2 login logout" } ],
        "powerShell": [ { "title": "Sign out", "command": "Disconnect-CirrusAccount" } ]
      }
    },
    {
      "name": "GetContextProcessor",
      "cliName": "login show",
      "psName": "Get-CirrusAccount",
      "extension": "login",
      "group": "login",
      "summary": "Show the current Azure account context.",
      "description": "Show the current Azure account context.",
      "parameters": [],
      "examples": {
        "cli": [ { "title": "Show current account", "command": "azv2 login show" } ],
        "powerShell": [ { "title": "Show current account", "command": "Get-CirrusAccount" } ]
      }
    },

    {
      "name": "NewResourceGroupProcessor",
      "cliName": "group create",
      "psName": "New-ResourceGroup",
      "extension": "resources",
      "group": "group",
      "summary": "Create a new resource group.",
      "description": "Provision a new resource group in your Azure subscription. Specify the resource group name, location (region), and subscription ID. An optional resource ID can be provided for advanced scenarios.",
      "parameters": [
        { "cliName": "subscription-id", "psName": "SubscriptionId", "type": "string", "required": true, "description": "Azure Subscription Id." },
        { "cliName": "name", "psName": "Name", "type": "string", "required": true, "description": "The name of the resource group." },
        { "cliName": "location", "psName": "Location", "type": "string", "required": true, "description": "Location for the resource group." },
        { "cliName": "resource-id", "psName": "ResourceId", "type": "string", "required": false, "description": "The resource id of the resource group." }
      ],
      "examples": {
        "cli": [
          { "title": "Create in East US", "command": "azv2 group create --name myresourcegroup --location eastus --subscription-id 00000000-0000-0000-0000-000000000000" },
          { "title": "Create with explicit resource id", "command": "azv2 group create --name myrg --location westus --resource-id /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/myrg --subscription-id 00000000-0000-0000-0000-000000000000" }
        ],
        "powerShell": [
          { "title": "Create a resource group", "command": "New-ResourceGroup -Name \"myresourcegroup\" -Location \"eastus\" -SubscriptionId \"00000000-0000-0000-0000-000000000000\"" }
        ]
      }
    },
    {
      "name": "ListResourceGroupProcessor",
      "cliName": "group list",
      "psName": "Get-ResourceGroup_List",
      "extension": "resources",
      "group": "group",
      "summary": "List all resource groups in a subscription.",
      "description": "Retrieve a list of all resource groups in the specified Azure subscription. If no subscription ID is provided, the default subscription from the current login context is used.",
      "parameters": [
        { "cliName": "subscription-id", "psName": "SubscriptionId", "type": "string", "required": false, "description": "Azure Subscription Id. Defaults to current login context." }
      ],
      "examples": {
        "cli": [
          { "title": "List with explicit subscription", "command": "azv2 group list --subscription-id 00000000-0000-0000-0000-000000000000" },
          { "title": "List using default subscription", "command": "azv2 group list" }
        ],
        "powerShell": [
          { "title": "List with explicit subscription", "command": "Get-ResourceGroup_List -SubscriptionId \"00000000-0000-0000-0000-000000000000\"" },
          { "title": "List using default subscription", "command": "Get-ResourceGroup_List" }
        ]
      }
    },
    {
      "name": "GetResourceGroupProcessor",
      "cliName": "group show",
      "psName": "Get-ResourceGroup_Get",
      "extension": "resources",
      "group": "group",
      "summary": "Show details of a specific resource group.",
      "description": "Display information about a resource group including its name, location, provisioning state, and resource count.",
      "parameters": [
        { "cliName": "subscription-id", "psName": "SubscriptionId", "type": "string", "required": false, "description": "Azure Subscription Id. Defaults to current login context." },
        { "cliName": "name", "psName": "Name", "type": "string", "required": false, "description": "The name of the resource group." }
      ],
      "examples": {
        "cli": [
          { "title": "Show with explicit subscription", "command": "azv2 group show --name myresourcegroup --subscription-id 00000000-0000-0000-0000-000000000000" },
          { "title": "Show using default subscription", "command": "azv2 group show --name myresourcegroup" }
        ],
        "powerShell": [
          { "title": "Show a resource group", "command": "Get-ResourceGroup_Get -Name \"myresourcegroup\" -SubscriptionId \"00000000-0000-0000-0000-000000000000\"" }
        ]
      }
    },

    {
      "name": "NewVMProcessor_NICCombined",
      "cliName": "vm create-combined",
      "psName": "New-VMCombined",
      "extension": "compute",
      "group": "vm",
      "summary": "Create a VM with the full networking stack (VNet + NSG + NIC + VM) in one call.",
      "description": "Provisions the full networking + VM stack as one operation. Creates a virtual network, network security group, network interface, and virtual machine using the supplied names and parameters.",
      "parameters": [
        { "cliName": "subscription-id", "psName": "SubscriptionId", "type": "string", "required": true, "description": "Azure Subscription Id." },
        { "cliName": "name", "psName": "Name", "type": "string", "required": true, "description": "The name of the virtual machine." },
        { "cliName": "location", "psName": "Location", "type": "string", "required": true, "description": "Location for all resources." },
        { "cliName": "resource-group", "psName": "ResourceGroupName", "type": "string", "required": true, "description": "The resource group name." },
        { "cliName": "vm-size", "psName": "VmSize", "type": "string", "required": true, "description": "The size of the virtual machine." },
        { "cliName": "admin-username", "psName": "AdminUsername", "type": "string", "required": true, "description": "The administrator username." },
        { "cliName": "admin-password", "psName": "AdminPassword", "type": "string", "required": true, "description": "The administrator password." },
        { "cliName": "network-interface-name", "psName": "NetworkInterfaceName", "type": "string", "required": true, "description": "The network interface name to create." },
        { "cliName": "virtual-network-name", "psName": "VirtualNetworkName", "type": "string", "required": true, "description": "The virtual network name to create." },
        { "cliName": "network-security-group-name", "psName": "NetworkSecurityGroupName", "type": "string", "required": true, "description": "The network security group name to create." },
        { "cliName": "subnet-names", "psName": "SubnetNames", "type": "list<string>", "required": false, "description": "Names of the subnets." },
        { "cliName": "subnet-address-prefixes", "psName": "SubnetAddressPrefixes", "type": "list<list<string>>", "required": false, "description": "Address prefixes for each subnet." },
        { "cliName": "address-prefixes", "psName": "AddressPrefixes", "type": "list<string>", "required": false, "description": "Address prefixes for the virtual network." },
        { "cliName": "rule-names", "psName": "RuleNames", "type": "list<string>", "required": false, "description": "Names of the security rules." },
        { "cliName": "rule-directions", "psName": "RuleDirections", "type": "list<string>", "required": false, "description": "Directions of the security rules." },
        { "cliName": "rule-protocols", "psName": "RuleProtocols", "type": "list<string>", "required": false, "description": "Protocols of the security rules." },
        { "cliName": "rule-priorities", "psName": "RulePriorities", "type": "list<int>", "required": false, "description": "Priorities of the security rules." },
        { "cliName": "rule-source-address-prefixes", "psName": "RuleSourceAddressPrefixes", "type": "list<string>", "required": false, "description": "Source address prefixes of the security rules." },
        { "cliName": "rule-source-port-ranges", "psName": "RuleSourcePortRanges", "type": "list<string>", "required": false, "description": "Source port ranges of the security rules." },
        { "cliName": "rule-destination-port-ranges", "psName": "RuleDestinationPortRanges", "type": "list<string>", "required": false, "description": "Destination port ranges of the security rules." },
        { "cliName": "rule-destination-address-prefixes", "psName": "RuleDestinationAddressPrefixes", "type": "list<string>", "required": false, "description": "Destination address prefixes of the security rules." },
        { "cliName": "rule-accesses", "psName": "RuleAccesses", "type": "list<string>", "required": false, "description": "Access types (Allow/Deny) of the security rules." }
      ],
      "examples": {
        "cli": [
          { "title": "Create VM with combined networking", "command": "azv2 vm create-combined --name myvm --location eastus --resource-group myrg --subscription-id 00000000-0000-0000-0000-000000000000 --vm-size Standard_D2s_v3 --admin-username azureuser --admin-password <password> --network-interface-name mynic --virtual-network-name myvnet --network-security-group-name mynsg" },
          { "title": "Create with explicit subnet and address prefixes", "command": "azv2 vm create-combined --name myvm --location eastus --resource-group myrg --subscription-id 00000000-0000-0000-0000-000000000000 --vm-size Standard_D2s_v3 --admin-username azureuser --admin-password <password> --network-interface-name mynic --virtual-network-name myvnet --network-security-group-name mynsg --subnet-names default --address-prefixes 10.0.0.0/16" }
        ],
        "powerShell": [
          { "title": "Create VM with combined networking", "command": "New-VMCombined -SubscriptionId \"00000000-0000-0000-0000-000000000000\" -Name \"myvm\" -Location \"eastus\" -ResourceGroupName \"myrg\" -VmSize \"Standard_D2s_v3\" -AdminUsername \"azureuser\" -AdminPassword \"<password>\" -NetworkInterfaceName \"mynic\" -VirtualNetworkName \"myvnet\" -NetworkSecurityGroupName \"mynsg\"" }
        ]
      }
    },
