<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtName>Core</ExtName>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.2.0" />
    <PackageReference Include="OpenTelemetry" Version="1.8.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Dev dependencies only included in Debug builds -->
    <!-- TODO: Remove NU1902 suppression after upgrading Zipkin exporter to a non-vulnerable version (track in issue). -->
    <PackageReference Include="OpenTelemetry.Exporter.Zipkin" Version="1.8.1" NoWarn="NU1902" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core.Abstractions\Core.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

</Project>
