<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Microsoft.Azure.Azclips.Extensions.Config</AssemblyName>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <RootNamespace>Microsoft.Azure.Azclips.Extensions.Config</RootNamespace>
        <ExtName>Microsoft.Azure.Azclips.Extensions.Config</ExtName>

        <Description>Configuration management extension for AzClips CLI</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Azure/azclips</RepositoryUrl>

        <PackageId>Microsoft.Azure.Azclips.Extensions.Config</PackageId>
        <Version>0.1.5</Version>
        <Authors>Microsoft Corporation</Authors>
        <Company>Microsoft Corporation</Company>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj" >
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\..\Core\Core.DependencyInjection\Core.DependencyInjection.csproj" >
            <Private>false</Private>
            <ExcludeAssets>all</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\..\Core\Core.Configuration\Core.Configuration.csproj" >
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>
</Project>