<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Microsoft.Azure.Azclips.Extensions.Extension</AssemblyName>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <RootNamespace>Microsoft.Azure.Azclips.Extensions.Extension</RootNamespace>
        <ExtName>Microsoft.Azure.Azclips.Extensions.Extension</ExtName>

        <Description>Extension management for Azclips CLI</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Azure/azclips</RepositoryUrl>

        <PackageId>Microsoft.Azure.Azclips.Extensions.Extension</PackageId>
        <Version>0.1.0</Version>
        <Authors>Microsoft Corporation</Authors>
        <Company>Microsoft Corporation</Company>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj" >
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\..\Core\Core.DependencyInjection\Core.DependencyInjection.csproj" >
            <Private>false</Private>
            <ExcludeAssets>all</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\..\Core\Core.Extensions\Core.Extensions.csproj" >
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NuGet.Packaging" Version="7.3.1" />
        <PackageReference Include="NuGet.Protocol" Version="7.3.1" />
        <PackageReference Include="NuGet.Resolver" Version="7.3.1" />
    </ItemGroup>

</Project>
