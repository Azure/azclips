{
  "commandId": "login.connect",
  "examples": [
    {
      "title": "Sign in with a subscription ID",
      "command": "azv2 login connect --subscription-id 00000000-0000-0000-0000-000000000000"
    },
    {
      "title": "Sign in with tenant and subscription",
      "command": "azv2 login connect --tenant-id 11111111-1111-1111-1111-111111111111 --subscription-id 00000000-0000-0000-0000-000000000000"
    }
  ]
}
