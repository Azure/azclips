<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Microsoft.Azure.Azclips.Extensions.Network</AssemblyName>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <RootNamespace>Microsoft.Azure.Azclips.Extensions.Network</RootNamespace>
        <ExtName>Microsoft.Azure.Azclips.Extensions.Network</ExtName>

        <Description>Network Extension for Azclips CLI</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Azure/azclips</RepositoryUrl>

        <PackageId>Microsoft.Azure.Azclips.Extensions.Network</PackageId>
        <Version>0.1.3</Version>
        <Authors>Microsoft Corporation</Authors>
        <Company>Microsoft Corporation</Company>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <!-- Models/ is verbatim Ace.Generator output, which does not yet initialize required reference
             properties (CS8618) or null-guard deep flattened setters (CS8602). Keep them visible as
             warnings instead of hand-editing generated files. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8618;CS8602</WarningsNotAsErrors>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj" >
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\ExtensionRuntime\ExtensionRuntime.csproj" >
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>
</Project>