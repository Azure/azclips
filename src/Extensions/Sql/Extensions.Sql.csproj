<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Azure.Azclips.Extensions.Sql</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>Microsoft.Azure.Azclips.Extensions.Sql</RootNamespace>
    <ExtName>Microsoft.Azure.Azclips.Extensions.Sql</ExtName>

    <Description>Sql Extension for Azclips CLI</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Azure/azclips</RepositoryUrl>

    <PackageId>Microsoft.Azure.Azclips.Extensions.Sql</PackageId>
    <Version>0.1.0</Version>
    <Authors>Microsoft Corporation</Authors>
    <Company>Microsoft Corporation</Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\ExtensionRuntime\ExtensionRuntime.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>