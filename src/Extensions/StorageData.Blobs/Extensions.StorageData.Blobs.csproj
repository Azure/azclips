<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Microsoft.Azure.Azclips.Extensions.StorageData.Blobs</AssemblyName>
        <RootNamespace>Microsoft.Azure.Azclips.Extensions.StorageData.Blobs</RootNamespace>
        <ExtName>Microsoft.Azure.Azclips.Extensions.StorageData.Blobs</ExtName>
        <Description>Mock StorageData Blobs extension demonstrating a shared storage command group.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Azure/azclips</RepositoryUrl>
        <PackageId>Microsoft.Azure.Azclips.Extensions.StorageData.Blobs</PackageId>
        <Version>0.1.0</Version>
        <Authors>Microsoft Corporation</Authors>
        <Company>Microsoft Corporation</Company>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>
</Project>
