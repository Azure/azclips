<Project>
  <UsingTask
    TaskName="GenerateExtensionSidecarTask"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProjectDir ParameterType="System.String" Required="true" />
      <PackageId ParameterType="System.String" Required="true" />
      <PackageVersion ParameterType="System.String" Required="false" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Build-time sidecar (CLIPS-933): regex-scans this extension's own source for
        // declared [ExtensionVerb] attributes and CLI leaf keys, so runtime discovery can
        // route commands (CLIPS-934) without loading the extension's DLL.
        // Source-scan, not reflection: mirrors src/CLI/Targets/ExtensionHints.targets so
        // generation never has to load/execute extension code.
        //
        // Two conventions exist in-tree for building the CLI command table, and both must
        // be handled:
        //   (a) dict-literal:   s_cliTable = new() { ["extension add"] = s_addExtension_CLI, ... }
        //   (b) builder-call:   cliTable = BuildCommandTable(cliLogin, cliLogout, ...)
        //       where each `cliXxx` is `CommandMetadata cliXxx = new(..., InvocationName: "...", ...)`
        // (b) has no literal leaf-key strings at all — the leaf comes from the referenced
        // CommandMetadata's InvocationName, resolved by field name below.
        var verbAttrPattern = new Regex(@"\[\s*ExtensionVerb\s*\(\s*""([^""]+)""\s*\)\s*\]", RegexOptions.Multiline);
        var fieldDeclPattern = new Regex(@"(?:private|internal|public)\s+static\s+readonly\s+CommandMetadata\s+(?<field>\w+)\s*=\s*new\b", RegexOptions.Multiline);
        var invocationNamePattern = new Regex(@"InvocationName\s*:\s*""(?<name>[^""]*)""", RegexOptions.Multiline);
        var dictLiteralTable = new Regex(@"\b(?:s_cliTable|cliTable)\s*=\s*new(?:\s*Dictionary<[^>]*>)?\s*\(\)\s*\{(?<body>[^{}]*)\}", RegexOptions.Multiline);
        var builderCallTable = new Regex(@"\b(?:s_cliTable|cliTable)\s*=\s*(?!new\b)\w+\s*\((?<args>[^;]*)\)\s*;", RegexOptions.Multiline);
        var leafKeyPattern = new Regex(@"\[\s*""([^""]+)""\s*\]", RegexOptions.Multiline);
        var identifierPattern = new Regex(@"\w+", RegexOptions.Multiline);

        var verbs = new SortedSet<string>(StringComparer.OrdinalIgnoreCase);
        var leaves = new SortedSet<string>(StringComparer.OrdinalIgnoreCase);

        if (Directory.Exists(ProjectDir))
        {
          foreach (var csFile in Directory.EnumerateFiles(ProjectDir, "*.cs", SearchOption.AllDirectories))
          {
            // Skip build output dirs so a stale copy can't be double-counted.
            if (csFile.Contains(Path.DirectorySeparatorChar + "obj" + Path.DirectorySeparatorChar) ||
                csFile.Contains(Path.DirectorySeparatorChar + "bin" + Path.DirectorySeparatorChar))
            {
              continue;
            }

            var text = File.ReadAllText(csFile);

            foreach (Match m in verbAttrPattern.Matches(text))
            {
              verbs.Add(m.Groups[1].Value);
            }

            // (a) dict-literal: leaf key is the literal bracket key, used as-is.
            foreach (Match block in dictLiteralTable.Matches(text))
            {
              foreach (Match leaf in leafKeyPattern.Matches(block.Groups["body"].Value))
              {
                leaves.Add(leaf.Groups[1].Value);
              }
            }

            // (b) builder-call: resolve each referenced field to its own InvocationName.
            // Fields don't nest, so the Nth declaration's InvocationName is whichever match
            // falls between its start and the next declaration's start (or EOF).
            var builderMatches = builderCallTable.Matches(text);
            if (builderMatches.Count > 0)
            {
              var fieldMatches = new List<Match>();
              foreach (Match fm in fieldDeclPattern.Matches(text)) { fieldMatches.Add(fm); }
              fieldMatches.Sort((x, y) => x.Index.CompareTo(y.Index));

              var invMatches = new List<Match>();
              foreach (Match im in invocationNamePattern.Matches(text)) { invMatches.Add(im); }

              var invocationNameByField = new Dictionary<string, string>(StringComparer.Ordinal);
              for (int i = 0; i < fieldMatches.Count; i++)
              {
                var start = fieldMatches[i].Index;
                var end = (i + 1 < fieldMatches.Count) ? fieldMatches[i + 1].Index : text.Length;
                foreach (var im in invMatches)
                {
                  if (im.Index >= start && im.Index < end)
                  {
                    invocationNameByField[fieldMatches[i].Groups["field"].Value] = im.Groups["name"].Value;
                    break;
                  }
                }
              }

              foreach (Match table in builderMatches)
              {
                foreach (Match arg in identifierPattern.Matches(table.Groups["args"].Value))
                {
                  if (invocationNameByField.TryGetValue(arg.Value, out var invocationName))
                  {
                    leaves.Add(invocationName);
                  }
                }
              }
            }
          }
        }


        var sb = new StringBuilder();
        sb.AppendLine("{");
        sb.AppendLine("  \"schemaVersion\": 1,");
        sb.Append("  \"generatedAt\": \"").Append(DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ")).AppendLine("\",");
        sb.Append("  \"packageId\": \"").Append(EscapeJson(PackageId)).AppendLine("\",");
        var version = string.IsNullOrEmpty(PackageVersion) ? "0.0.0" : PackageVersion;
        sb.Append("  \"version\": \"").Append(EscapeJson(version)).AppendLine("\",");

        sb.AppendLine("  \"verbs\": [");
        int vi = 0;
        foreach (var verb in verbs)
        {
          var comma = (++vi == verbs.Count) ? "" : ",";
          sb.Append("    \"").Append(EscapeJson(verb)).Append("\"").AppendLine(comma);
        }
        sb.AppendLine("  ],");

        sb.AppendLine("  \"leaves\": [");
        int li = 0;
        foreach (var leaf in leaves)
        {
          var comma = (++li == leaves.Count) ? "" : ",";
          sb.Append("    \"").Append(EscapeJson(leaf)).Append("\"").AppendLine(comma);
        }
        sb.AppendLine("  ]");
        sb.AppendLine("}");

        // Path.GetDirectoryName returns null for a bare filename; Directory.CreateDirectory(null) throws.
        var outputDir = Path.GetDirectoryName(OutputFile);
        if (!string.IsNullOrEmpty(outputDir))
        {
          Directory.CreateDirectory(outputDir);
        }
        File.WriteAllText(OutputFile, sb.ToString());
        Log.LogMessage(MessageImportance.Normal, $"[ExtensionSidecar] Wrote {leaves.Count} leaf/leaves, {verbs.Count} verb(s) for '{PackageId}' to {OutputFile}");

        // Source-derived values (verbs, leaf keys, package id/version) are not guaranteed to be
        // JSON-safe — escape every emitted string so a stray quote/backslash/control character
        // can't produce malformed JSON or silently relabel a command.
        string EscapeJson(string value)
        {
          var escaped = new StringBuilder(value.Length);
          foreach (var c in value)
          {
            switch (c)
            {
              case '"': escaped.Append("\\\""); break;
              case '\\': escaped.Append("\\\\"); break;
              case '\n': escaped.Append("\\n"); break;
              case '\r': escaped.Append("\\r"); break;
              case '\t': escaped.Append("\\t"); break;
              case '\b': escaped.Append("\\b"); break;
              case '\f': escaped.Append("\\f"); break;
              default:
                if (c < 0x20)
                {
                  escaped.Append("\\u").Append(((int)c).ToString("x4"));
                }
                else
                {
                  escaped.Append(c);
                }
                break;
            }
          }
          return escaped.ToString();
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- v1 scope (CLIPS-933): just the s_cliTable leaf keys + declared verbs, no parameter/help
       metadata yet. Runs after Build so $(OutputPath) already exists; the sidecar sits next to
       the extension's own DLL, e.g. artifacts/Debug/<ExtName>/<PackageId>.commands.json. -->
  <Target Name="GenerateExtensionSidecar"
          AfterTargets="Build"
          Outputs="$(OutputPath)$(PackageId).commands.json">
    <GenerateExtensionSidecarTask
      ProjectDir="$(MSBuildProjectDirectory)"
      PackageId="$(PackageId)"
      PackageVersion="$(Version)"
      OutputFile="$(OutputPath)$(PackageId).commands.json" />
  </Target>

  <!-- Packaging (build_common.sh) runs "dotnet build" then a separate publish step with the
       NoBuild flag set, to stage builtin extension publish output. NoBuild skips the Build target
       entirely, so the AfterTargets="Build" hook above never re-runs during that publish
       invocation, and the sidecar (written directly via File.WriteAllText, not a tracked MSBuild
       item) would never be copied into the publish directory on its own. Register the file
       (already on disk from the earlier build step) as a ResolvedFileToPublish right before the
       publish file list is computed, so it's included in publish output even with NoBuild set. -->
  <Target Name="AddExtensionSidecarToPublishList"
          BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup Condition="Exists('$(OutputPath)$(PackageId).commands.json')">
      <ResolvedFileToPublish Include="$(OutputPath)$(PackageId).commands.json">
        <RelativePath>$(PackageId).commands.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
