<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtName>Login</ExtName>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj" />
    <ProjectReference Include="..\..\Core\Core.Engine\Core.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Include Business, Commands, and Cmdlets folders from parent directory -->
  <ItemGroup>
    <Compile Include="..\Business\**\*.cs" />
    <Compile Include="..\Commands\**\*.cs" />
    <Compile Include="..\Cmdlets\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" />
  </ItemGroup>

</Project>
