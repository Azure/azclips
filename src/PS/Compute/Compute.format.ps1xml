<?xml version="1.0" encoding="utf-8"?>
<!--
  Default view for the Compute models.

  Two reasons this exists rather than relying on PowerShell's defaults:

  1. PowerShell picks its formatter by property count - four or fewer renders
     as a table, five or more as a list. VirtualMachine currently sits above
     that threshold, but adding or removing a single property would silently
     flip the rendering to a table, where the long ARM resource Id consumes
     the whole console width and the remaining columns are dropped.

  2. PowerState/PrivateIps/PublicIps/Fqdns/MacAddresses are only populated by
     the CLI's `az vm show -d`. On every other call they are null, and without
     the conditions below they render as five blank rows.
-->
<Configuration>
  <ViewDefinitions>

    <View>
      <Name>VirtualMachine</Name>
      <ViewSelectedBy>
        <TypeName>Microsoft.Azure.Azclips.Extensions.Compute.Models.VirtualMachine</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>

              <ListItem>
                <PropertyName>Name</PropertyName>
              </ListItem>

              <ListItem>
                <PropertyName>Location</PropertyName>
              </ListItem>

              <ListItem>
                <PropertyName>Id</PropertyName>
              </ListItem>

              <!-- Detail fields: shown only when `az vm show -d` populated them. -->
              <ListItem>
                <ItemSelectionCondition>
                  <ScriptBlock>-not [string]::IsNullOrEmpty($_.PowerState)</ScriptBlock>
                </ItemSelectionCondition>
                <PropertyName>PowerState</PropertyName>
              </ListItem>

              <ListItem>
                <ItemSelectionCondition>
                  <ScriptBlock>-not [string]::IsNullOrEmpty($_.PrivateIps)</ScriptBlock>
                </ItemSelectionCondition>
                <PropertyName>PrivateIps</PropertyName>
              </ListItem>

              <ListItem>
                <ItemSelectionCondition>
                  <ScriptBlock>-not [string]::IsNullOrEmpty($_.PublicIps)</ScriptBlock>
                </ItemSelectionCondition>
                <PropertyName>PublicIps</PropertyName>
              </ListItem>

              <ListItem>
                <ItemSelectionCondition>
                  <ScriptBlock>-not [string]::IsNullOrEmpty($_.Fqdns)</ScriptBlock>
                </ItemSelectionCondition>
                <PropertyName>Fqdns</PropertyName>
              </ListItem>

              <ListItem>
                <ItemSelectionCondition>
                  <ScriptBlock>-not [string]::IsNullOrEmpty($_.MacAddresses)</ScriptBlock>
                </ItemSelectionCondition>
                <PropertyName>MacAddresses</PropertyName>
              </ListItem>

              <!-- Last: the properties bag renders as a multi-line JSON block. -->
              <ListItem>
                <PropertyName>Properties</PropertyName>
              </ListItem>

            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

  </ViewDefinitions>
</Configuration>
