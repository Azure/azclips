<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Azure.Azclips.Cmdlets.Deployment</AssemblyName>
    <RootNamespace>Microsoft.Azure.Azclips.Cmdlets.Deployment</RootNamespace>
    <Description>PowerShell binary cmdlets for AzClips Deployment module</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />
  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.6.1" PrivateAssets="all" />
    <Compile Include="..\Common\CmdletOutputStreamsFactory.cs" Link="Common\CmdletOutputStreamsFactory.cs" />
    <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\Core\Core.DependencyInjection\Core.DependencyInjection.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\Extensions\Deployment\Extensions.Deployment.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
