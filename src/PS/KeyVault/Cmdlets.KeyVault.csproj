<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Microsoft.Azure.Azclips.Cmdlets.KeyVault</AssemblyName>
        <RootNamespace>Microsoft.Azure.Azclips.Cmdlets.KeyVault</RootNamespace>
        <Description>PowerShell cmdlets for the Azclips Key Vault extension</Description>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />
    <ItemGroup>
        <PackageReference Include="System.Management.Automation" PrivateAssets="all" />
        <Compile Include="..\Common\CmdletOutputStreamsFactory.cs" Link="Common\CmdletOutputStreamsFactory.cs" />
        <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\..\Core\Core.DependencyInjection\Core.DependencyInjection.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>
</Project>