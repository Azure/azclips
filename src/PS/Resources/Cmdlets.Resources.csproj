<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Microsoft.Azure.Azclips.Cmdlets.Resources</AssemblyName>
        <ExtName>Microsoft.Azure.Azclips.Cmdlets.Resources</ExtName>
        <PowerShellModuleArtifactName>Microsoft.Azure.Azclips.Extensions.Resources</PowerShellModuleArtifactName>
        <PowerShellModuleManifest>Resources.psd1</PowerShellModuleManifest>
        <RootNamespace>Microsoft.Azure.Azclips.Cmdlets.Resources</RootNamespace>
        <Description>PowerShell binary cmdlets for AzClips Resources module</Description>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\..\Shared.props" />

    <ItemGroup>
        <PackageReference Include="System.Management.Automation" Version="7.6.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Common\CmdletOutputStreamsFactory.cs" Link="Common\CmdletOutputStreamsFactory.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Accounts\Cmdlets.Accounts.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\Core\Core.Abstractions\Core.Abstractions.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\..\Core\Core.DependencyInjection\Core.DependencyInjection.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\..\Extensions\Resources\Extensions.Resources.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>
</Project>
