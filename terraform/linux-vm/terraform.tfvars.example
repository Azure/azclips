# Example variable values. Copy to terraform.tfvars and adjust.
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init
#   terraform plan
#   terraform apply
#
# The E2E test drives the VM through `az vm run-command` (no SSH), so no SSH key
# or firewall CIDR is required — the VM's admin keypair is generated by Terraform
# and never used to connect.
#
# Required input (no default — must be set here):
#   - resource_group_name

# REQUIRED — name of the EXISTING resource group to deploy into.
resource_group_name = "ming-test"

# Optional overrides:
# subscription_id         = "0c302431-1ad0-4187-87c9-d4cebcf7edc2"
# vm_name                 = "ming-test-vm"
# vm_size                 = "Standard_B2s"
# admin_username          = "azureuser"
# os_disk_type            = "Standard_LRS"
# tags = {
#   owner   = "ming"
#   purpose = "test"
# }
