# Example variable values. Copy to terraform.tfvars and adjust.
#
#   cp terraform.tfvars.example terraform.tfvars
#   ./provision-infrastructure.sh
#
# The live test drives the VM through `az vm run-command` (no SSH), so no SSH key
# or firewall CIDR is required — the VM's admin keypair is generated by Terraform
# and never used to connect.
#
# Required input (no default — must be set here):
#   - alias

# REQUIRED — your short user alias. Prefixes the resource group, VM, and managed
# identity, and selects your own Terraform state blob, so several developers can
# share one subscription. 3-14 chars, lowercase, must start with a letter, only
# a-z 0-9 and '-'. Use the SAME alias as in terraform/bootstrap.
alias = "ming"

# Optional overrides:
# location                = "australiaeast"
# resource_group_name     = "<alias>-cirrus-live-test-mi-rg"   # default derives from alias
# vm_name                 = "<alias>-cirrus-live-test-mi-vm"   # default derives from alias
# vm_size                 = "Standard_D2s_v4"
# admin_username          = "azureuser"
# os_disk_type            = "Standard_LRS"
#
# Local SSH access (optional — leave unset for the CI/no-SSH default):
#   Provide your own key and lock inbound port 22 to your IP so you can SSH in.
# ssh_public_key          = "ssh-ed25519 AAAA... you@host"
# allowed_ssh_source_cidr = "1.2.3.4/32"   # your IP; or "*" to allow any
#
# tags = {
#   owner   = "ming"
#   purpose = "test"
# }

# tenant_id / subscription_id are not set here: the wrapper script passes them
# from your active `az` context, so the run always follows the subscription you
# selected with `az account set`.
