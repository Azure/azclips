<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ExtName>Benchmark</ExtName>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Benchmark</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>Benchmark.Program</StartupObject>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Shared.props" />

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.1" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.Runtime\Core.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Core\Core.DependencyInjection\Core.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Extensions\Resources\Extensions.Resources.csproj" />
    <ProjectReference Include="..\..\src\CLI\Core.Cli.csproj" />
    <ProjectReference Include="..\Common\Tests.Common.csproj" />
  </ItemGroup>

  <!--
    Stage configuration-specific copies of src/PS/<Module>/<Module>.psd1 into
    artifacts/$(Configuration)/PS/<Module>/. The PS benchmarks import from this
    artifact path so we never have to mutate the tracked source manifests
    (which previously left the working tree dirty and broke the gh-pages
    publish step in .github/workflows/benchmark.yml).
  -->
  <Target Name="StagePsModuleManifests" AfterTargets="Build">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\Set-ModuleConfiguration.ps1&quot; -Configuration $(Configuration)" />
  </Target>

</Project>
