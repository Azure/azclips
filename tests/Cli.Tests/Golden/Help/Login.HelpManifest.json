{
  "extension": "login",
  "version": "1.0.0-alpha",
  "rootSummary": "Authenticate to Azure.",
  "commands": [
    {
      "cliName": "login",
      "psName": "Connect-CirrusAccount",
      "summary": "Authenticate to Azure and set the current account context.",
      "description": "Authenticate to Azure and persist account context for subsequent commands.",
      "parameters": [
        {
          "name": "subscription-id",
          "psName": "SubscriptionId",
          "type": "string",
          "required": true,
          "description": "Azure Subscription Id.",
          "aliases": [],
          "allowedValues": [],
          "parameterSetName": "(All)",
          "supportsPipeline": false,
          "supportsWildcards": false
        },
        {
          "name": "tenant-id",
          "psName": "TenantId",
          "type": "string",
          "required": false,
          "description": "Tenant ID to login to.",
          "aliases": [],
          "allowedValues": [],
          "parameterSetName": "(All)",
          "supportsPipeline": false,
          "supportsWildcards": false
        },
        {
          "name": "use-device-code",
          "psName": "UseDeviceCode",
          "type": "bool",
          "required": false,
          "description": "Use device code flow for authentication.",
          "aliases": [],
          "allowedValues": [],
          "parameterSetName": "(All)",
          "supportsPipeline": false,
          "supportsWildcards": false
        }
      ],
      "examples": {
        "cli": [
          {
            "title": "Login with subscription id (CLI)",
            "command": "azv2 login --subscription-id 00000000-0000-0000-0000-000000000000"
          },
          {
            "title": "Login with device code (CLI)",
            "command": "azv2 login --subscription-id 00000000-0000-0000-0000-000000000000 --use-device-code"
          }
        ],
        "powerShell": [
          {
            "title": "Login with subscription id (PowerShell)",
            "command": "Connect-CirrusAccount -SubscriptionId 00000000-0000-0000-0000-000000000000"
          },
          {
            "title": "Login with device code (PowerShell)",
            "command": "Connect-CirrusAccount -SubscriptionId 00000000-0000-0000-0000-000000000000 -UseDeviceCode"
          }
        ]
      },
      "tags": []
    },
    {
      "cliName": "login logout",
      "psName": "Disconnect-CirrusAccount",
      "summary": "Sign out from the current Azure account context.",
      "description": "Sign out from the current Azure account context.",
      "parameters": [],
      "examples": {
        "cli": [
          {
            "title": "Sign out (CLI)",
            "command": "azv2 login logout"
          }
        ],
        "powerShell": [
          {
            "title": "Sign out (PowerShell)",
            "command": "Disconnect-CirrusAccount"
          }
        ]
      },
      "tags": []
    },
    {
      "cliName": "login show",
      "psName": "Get-CirrusAccount",
      "summary": "Show the current Azure account context.",
      "description": "Show the current Azure account context.",
      "parameters": [],
      "examples": {
        "cli": [
          {
            "title": "Show current account context (CLI)",
            "command": "azv2 login show"
          }
        ],
        "powerShell": [
          {
            "title": "Show current account context (PowerShell)",
            "command": "Get-CirrusAccount"
          }
        ]
      },
      "tags": []
    }
  ]
}