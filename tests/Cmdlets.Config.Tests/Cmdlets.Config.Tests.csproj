<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../../src/MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Common/CmdletOutputStreamsFactory.cs compiles into both Cmdlets.Config and Cmdlets.Accounts, so its internal
      types reach this project twice (CS0433). The alias hides the Config copy; tests that need a Config type add
      `extern alias CmdletsConfig;`.
    -->
    <ProjectReference Include="../../src/PS/Config/Cmdlets.Config.csproj">
      <Aliases>CmdletsConfig</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/PS/Accounts/Cmdlets.Accounts.csproj" />
    <ProjectReference Include="../../src/Extensions/Config/Extensions.Config.csproj" />
    <ProjectReference Include="../../src/Core/Core.Abstractions/Core.Abstractions.csproj" />
    <ProjectReference Include="../../src/Core/Core.DependencyInjection/Core.DependencyInjection.csproj" />
    <ProjectReference Include="../Common/Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.Management.Automation" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.7" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
