<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../../src/MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Common/CmdletOutputStreamsFactory.cs compiles into Cmdlets.Config, Cmdlets.Accounts, Cmdlets.Compute and Cmdlets.Storage,
      so its internal types reach this project more than once (CS0433). The aliases hide the Config,
      Compute and Storage copies; a test needing one of their types must add `extern alias CmdletsConfig;`,
      `extern alias CmdletsCompute;` or `extern alias CmdletsStorage;`.
    -->
    <ProjectReference Include="../../src/PS/Config/Cmdlets.Config.csproj">
      <Aliases>CmdletsConfig</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/PS/Compute/Cmdlets.Compute.csproj">
      <Aliases>CmdletsCompute</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/PS/Accounts/Cmdlets.Accounts.csproj" />
    <ProjectReference Include="../../src/PS/ManagedServiceIdentity/Cmdlets.ManagedServiceIdentity.csproj" />
    <ProjectReference Include="../../src/PS/Resources/Cmdlets.Resources.csproj" />
    <ProjectReference Include="../../src/PS/Storage/Cmdlets.Storage.csproj">
      <Aliases>CmdletsStorage</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/Extensions/Storage/Extensions.Storage.csproj" />
    <ProjectReference Include="../../src/Extensions/Accounts/Extensions.Accounts.csproj" />
    <ProjectReference Include="../../src/Extensions/ManagedServiceIdentity/Extensions.ManagedServiceIdentity.csproj" />
    <ProjectReference Include="../../src/Extensions/Resources/Extensions.Resources.csproj" />
    <ProjectReference Include="../../src/Core/Core.ArgumentParsing/Core.ArgumentParsing.csproj" />
    <ProjectReference Include="../../src/Core/Core.Abstractions/Core.Abstractions.csproj" />
    <ProjectReference Include="../../src/Core/Core.DependencyInjection/Core.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/Core/Core.Telemetry/Core.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.Management.Automation" />
  </ItemGroup>

</Project>
