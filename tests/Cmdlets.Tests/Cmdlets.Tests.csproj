<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../../src/MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Extensions/Compute/Extensions.Compute.csproj" />
    <!--
      Common/CmdletOutputStreamsFactory.cs compiles into both Cmdlets.Config and Cmdlets.Login,
      so its internal types reach this project twice (CS0433). The alias hides Config's copy;
      a test needing a Config type must add `extern alias CmdletsConfig;`.
    -->
    <ProjectReference Include="../../src/PS/Config/Cmdlets.Config.csproj">
      <Aliases>CmdletsConfig</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/PS/Login/Cmdlets.Login.csproj" />
    <ProjectReference Include="../../src/Extensions/Login/Extensions.Login.csproj" />
    <ProjectReference Include="../../src/Core/Core.ArgumentParsing/Core.ArgumentParsing.csproj" />
    <ProjectReference Include="../../src/Core/Core.Abstractions/Core.Abstractions.csproj" />
    <ProjectReference Include="../../src/Core/Core.Telemetry/Core.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.Management.Automation" Version="7.6.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/PS/Compute/Compute.format.ps1xml" Link="Compute.format.ps1xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/PS/Compute/Compute.psd1" Link="Compute.psd1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
