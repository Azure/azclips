<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../../src/MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PS/Accounts/Cmdlets.Accounts.csproj" />
    <!--
      Common/CmdletOutputStreamsFactory.cs compiles into Cmdlets.Accounts, Cmdlets.KeyVault and Cmdlets.MsGraph, so its
      internal types reach this project more than once (CS0433). The aliases hide the KeyVault and MsGraph copies; a
      test needing one of their types must add `extern alias CmdletsKeyVault;` or `extern alias CmdletsMsGraph;`.
    -->
    <ProjectReference Include="../../src/PS/KeyVault/Cmdlets.KeyVault.csproj">
      <Aliases>CmdletsKeyVault</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/Extensions/KeyVault/Extensions.KeyVault.csproj" />
    <ProjectReference Include="../../src/PS/MsGraph/Cmdlets.MsGraph.csproj">
      <Aliases>CmdletsMsGraph</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/Extensions/MsGraph/Extensions.MsGraph.csproj" />
    <ProjectReference Include="../../src/Core/Core.Engine/Core.Engine.csproj" />
    <ProjectReference Include="../../src/Core/Core.Runtime/Core.Runtime.csproj" />
    <ProjectReference Include="../../src/PS/ManagedServiceIdentity/Cmdlets.ManagedServiceIdentity.csproj" />
    <ProjectReference Include="../../src/PS/Resources/Cmdlets.Resources.csproj" />
    <ProjectReference Include="../../src/Extensions/Accounts/Extensions.Accounts.csproj" />
    <ProjectReference Include="../../src/Extensions/ManagedServiceIdentity/Extensions.ManagedServiceIdentity.csproj" />
    <ProjectReference Include="../../src/Extensions/Resources/Extensions.Resources.csproj" />
    <ProjectReference Include="../../src/Core/Core.ArgumentParsing/Core.ArgumentParsing.csproj" />
    <ProjectReference Include="../../src/Core/Core.Abstractions/Core.Abstractions.csproj" />
    <ProjectReference Include="../../src/Core/Core.DependencyInjection/Core.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/Core/Core.Telemetry/Core.Telemetry.csproj" />
    <ProjectReference Include="../Common/Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.Management.Automation" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.7" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
