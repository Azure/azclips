<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../../src/MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Aliased to avoid CS0433. src/PS/Common/CmdletOutputStreamsFactory.cs is <Compile>-linked
      into both Cmdlets.Login and Cmdlets.Config, and both grant InternalsVisibleTo to this
      project, so its internal types would otherwise arrive here twice. Aliasing removes every
      Cmdlets.Config type from the global namespace — a test that needs one must declare
      `extern alias CmdletsConfig;` at the top of the file.
    -->
    <ProjectReference Include="../../src/PS/Config/Cmdlets.Config.csproj">
      <Aliases>CmdletsConfig</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/PS/Login/Cmdlets.Login.csproj" />
    <ProjectReference Include="../../src/Extensions/Login/Extensions.Login.csproj" />
    <ProjectReference Include="../../src/Core/Core.ArgumentParsing/Core.ArgumentParsing.csproj" />
    <ProjectReference Include="../../src/Core/Core.Abstractions/Core.Abstractions.csproj" />
    <ProjectReference Include="../../src/Core/Core.Telemetry/Core.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.Management.Automation" Version="7.6.1" />
  </ItemGroup>

</Project>
