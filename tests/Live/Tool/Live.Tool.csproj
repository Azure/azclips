<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Live.Tool</RootNamespace>
    <AssemblyName>Live.Tool</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- tests/Directory.Build.props adds the xUnit/VSTest package set to every
         project under tests/. This one is a console tool, not a test assembly:
         leaving Microsoft.NET.Test.Sdk in would make `dotnet test` on the
         solution try to run it as one. -->
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Live.Tool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Remove="coverlet.collector" />
    <PackageReference Remove="Microsoft.NET.Test.Sdk" />
    <PackageReference Remove="xunit" />
    <PackageReference Remove="xunit.runner.visualstudio" />
    <Using Remove="Xunit" />
  </ItemGroup>

</Project>
