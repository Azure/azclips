{
  "name": "azure-client-engine-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ir",
    "packages/typespec-emitter",
    "packages/compiler",
    "packages/transformers",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:all": "npm run build --workspaces --if-present",
    "clean": "tsc -b --clean",
    "clean:all": "npm run clean --workspaces --if-present",
    "rebuild": "npm run clean && npm run build",
    "test": "npm run test --workspaces --if-present",
    "lint:deps": "syncpack lint",
    "fix:deps": "syncpack fix-mismatches",
    "schema": "npm run schema -w @azure-client-engine/ir --",
    "schema:check": "npm run schema:check -w @azure-client-engine/ir --",
    "login": "npm install @microsoft/artifacts-npm-credprovider -g --registry https://pkgs.dev.azure.com/artifacts-public/PublicTools/_packaging/AzureArtifacts/npm/registry/ && artifacts-npm-credprovider -c ./.npmrc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Azure Client Engine toolkit monorepo",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "syncpack": "^15.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
