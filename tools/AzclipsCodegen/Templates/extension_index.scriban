{{~ if op.has_rg ~}}
                ["ResourceGroupName"] = new("ResourceGroupName", "ResourceGroupName", typeof(string), "The resource group name.", IsRequired: true, Aliases: [], AllowedValues: []),
{{~ end ~}}
{{~ is_terminal = terminal_kind op.kind ~}}
{{~ slot_seen = [] ~}}
{{~ for slot in op.path_slots ~}}
{{~ if for.last && is_terminal && op.has_name ~}}
{{~ if !(slot_seen | array.contains "Name") ~}}
{{~ slot_seen = slot_seen | array.add "Name" ~}}
