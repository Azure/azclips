{{~ if op.has_rg ~}}
                ["resource-group"]  = new("ResourceGroupName", "resource-group", typeof(string), "The resource group name.", IsRequired: true, Aliases: ["-g"], AllowedValues: []),
{{~ end ~}}
{{~ is_terminal = terminal_kind op.kind ~}}
{{~ slot_seen = [] ~}}
{{~ for slot in op.path_slots ~}}
