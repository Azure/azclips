        // CLI/PS alias without touching the generator, do it there. See Custom/README.md.
        private static readonly Dictionary<string, CommandMetadata> s_psTable = new()
        {
{{~ ps_added = [] ~}}
{{~ for op in ops ~}}
{{~ if !(ps_added | array.contains op.ps_invocation_name) ~}}
{{~ ps_added = ps_added | array.add op.ps_invocation_name ~}}
{{~ effective_processor = cfg_map_str model.config "orchestrator_overrides" op.processor_class op.processor_class ~}}
            ["{{ op.ps_invocation_name }}"] = s_{{ effective_processor }}_PS,
{{~ end ~}}
{{~ end ~}}
        };

        private static readonly Dictionary<string, CommandMetadata> s_cliTable = new()
        {
{{~ cli_added = [] ~}}
{{~ for op in ops ~}}
{{~ if !(cli_added | array.contains op.cli_invocation_name) ~}}
{{~ cli_added = cli_added | array.add op.cli_invocation_name ~}}
{{~ cli_var_suffix = sanitize_ident op.cli_invocation_name ~}}
{{~ effective_processor = cfg_map_str model.config "orchestrator_overrides" op.processor_class op.processor_class ~}}
            ["{{ op.cli_invocation_name }}"] = s_{{ effective_processor }}_CLI_{{ cli_var_suffix }},
{{~ end ~}}
