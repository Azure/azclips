                ["{{ p.cli_name }}"] = new("{{ p.ps_name }}", "{{ p.cli_name }}", {{ p.ps_type_metadata }}, "{{ p.description | escape_quotes }}", IsRequired: {{ p.required ? "true" : "false" }}, Aliases: [], AllowedValues: []),
