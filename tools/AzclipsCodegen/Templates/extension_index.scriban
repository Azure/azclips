{{~ end ~}}
{{~ else ~}}
{{~ lk = slot[0] | kebab ~}}
{{~ if !(slot_seen | array.contains lk) ~}}
{{~ slot_seen = slot_seen | array.add lk ~}}
                ["{{ lk }}"] = new("{{ slot[0] }}", "{{ lk }}", typeof(string), "{{ slot_desc_or slot slot[0] }}.", IsRequired: true, Aliases: [{{ if lk == "name" }}"-n"{{ end }}], AllowedValues: []),
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ body_seen = [] ~}}
{{~ for p in op.body_params ~}}
