<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="RuntimeIdentifier;SelfContained;UseAppHost">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ExtName>Tools/ExtensionSidecar</ExtName>
    <!-- This build-time tool runs on the host, not the extension's target runtime. -->
    <RuntimeIdentifier></RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <Import Project="..\..\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.Extensions\Core.Extensions.csproj" />
  </ItemGroup>
</Project>
