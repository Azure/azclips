# Cirrus Wiki Deployment Configuration
# Copy this file to .env and fill in your values
# Run ./setup-deployment.sh to automatically configure and upload secrets to GitHub

# Azure Service Principal (automatically created if not present)
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_TENANT_ID=your-tenant-id-here

# Storage Account Name (lowercase, 3-24 alphanumeric characters)
# Will be prompted during setup if not present
CIRRUS_WEB_STORAGE=yourstorageaccountname
RESOURCE_GROUP=your-resource-group-name